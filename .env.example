# Turso / libSQL database (required in production, e.g. on Vercel).
# Create a database at https://turso.tech, then:
#   turso db show <name> --url        -> TURSO_DATABASE_URL
#   turso db tokens create <name>     -> TURSO_AUTH_TOKEN
# Leave both unset in development to use a local SQLite file (data/bracketline.db).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Password-reset emails (optional). Without a key, reset links are written to
# the server logs instead of being emailed. Get a key at https://resend.com.
RESEND_API_KEY=
# Verified sender address; defaults to Resend's shared onboarding address.
EMAIL_FROM=

# Only needed if links must point at a fixed domain; otherwise the request's
# own host is used.
APP_URL=
