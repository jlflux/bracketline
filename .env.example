# Turso / libSQL database (required in production, e.g. on Vercel).
# Create a database at https://turso.tech, then:
#   turso db show <name> --url        -> TURSO_DATABASE_URL
#   turso db tokens create <name>     -> TURSO_AUTH_TOKEN
# Leave both unset in development to use a local SQLite file (data/bracketline.db).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
